# ============================================================
# bothostgtagame — переменные окружения (копия для примера)
# Скопируйте этот файл в .env.local и заполните значениями.
# ВНИМАНИЕ: реальный .env.local никогда не коммитится в git!
#
# ПРОДАКШЕН-РЕЖИМ: user = agent. Весь обмен с HostGta.ru идёт
# от имени одного сервисного аккаунта-агента через чистый HTTP.
# Эмуляция браузера (Puppeteer) в проекте НЕ используется.
# ============================================================

# --- Аккаунт агента на HostGta.ru ---
# Логин (email или ник) сервисного аккаунта-агента.
AGENT_LOGIN=agent@example.com
# Пароль агента (нужен только если не задана AGENT_SESSION_COOKIE).
AGENT_PASSWORD=change-me
# Готовая сессионная cookie агента, например: PHPSESSID=abc123...
# РЕКОМЕНДУЕТСЯ для продакшена: токен живёт дольше, пароль не светится
# в переменных окружения и не триггерит защиту от частых логинов.
AGENT_SESSION_COOKIE=

# --- Базовые адреса ---
HOSTGTA_BASE_URL=https://hostgta.ru

# --- Обход Cloudflare / антиботов (опционально) ---
# Один HTTP/SOCKS прокси для запросов агента, если HostGta банит
# IP вашего сервера по rate-limit, например: http://user:pass@proxy:8000
AGENT_PROXY_URL=
# User-Agent агента (пусто = встроенный дефолт bothostgtagame/1.0).
AGENT_USER_AGENT=

# --- Мониторинг сервера ---
# Интервал фонового мониторинга в минутах (используется cron-эндпоинтом).
MONITOR_INTERVAL_MIN=60
# ID сервера пользователя на HostGta ('default' = основной сервер аккаунта).
SERVER_ID=default
# Одноразовый секрет для защиты cron-эндпоинтов (/api/cron/*).
CRON_SECRET=change-me-random-string

# --- Подпись токенов доступа к дашборду ---
# HMAC-секрет для токенов, выдаваемых после верификации Friend Key.
TOKEN_SECRET=change-me-long-random-string

# --- Rate limiting API ---
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=20
